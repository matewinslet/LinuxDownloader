{
  "manifest_version": 3,
  "name": "Linux Download Manager",
  "version": "2.8.7",
  "description": "Silent Download Interceptor + Video Sender",
  "permissions": [
    "downloads",
    "activeTab",
    "scripting",
    "contextMenus",
    "cookies",
    "webRequest",
    "storage",
    "webNavigation",
    "alarms"
  ],
  "icons": {
    "16": "icon-16.png",
    "32": "icon-32.png",
    "48": "icon-48.png",
    "96": "icon-96.png",
    "128": "icon-128.png"
  },
  "action": {
    "default_title": "Linux DM",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icon-16.png",
      "32": "icon-32.png",
      "48": "icon-48.png",
      "96": "icon-96.png",
      "128": "icon-128.png"
    }
  },
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content.js"
      ],
      "all_frames": true
    }
  ]
}
